# Caddy reverse proxy in front of FlareSolverr.
# - GET /  and GET /health are public — the Go client pings / to wake the
#   container; SnapDeploy's health proxy probes /health.
# - Everything else requires `Authorization: Bearer $FLARESOLVERR_TOKEN`.
:{$PORT:8080} {
	@health path / /health
	handle @health {
		@probe path /health
		respond @probe 200
		reverse_proxy localhost:8192
	}

	handle {
		@unauth not header Authorization "Bearer {$FLARESOLVERR_TOKEN}"
		respond @unauth 401
		reverse_proxy localhost:8192
	}
}
